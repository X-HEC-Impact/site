# ------------------------------------------------------------------
# Copiez ce fichier en .env.local pour lancer le site en local,
# et renseignez les mêmes variables dans Vercel (Settings → Environment Variables).
# Ne commitez JAMAIS .env.local : il contient des secrets.
# ------------------------------------------------------------------

# Adresse publique du site (sert aux images de partage sur les réseaux).
NEXT_PUBLIC_SITE_URL=https://xhec-impact.vercel.app

# Supabase → Project Settings → Data API : « Project URL ».
SUPABASE_URL=https://votre-projet.supabase.co

# Supabase → Project Settings → API Keys : clé secrète « service_role » (ou « secret »).
# Elle donne tous les droits : elle reste côté serveur, jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=
